<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1250"
             xmlns:model="using:Taix.Client.ViewModels"
             x:DataType="model:SettingPageViewModel"
             xmlns:Btn="using:Taix.Client.Controls.Button"
             xmlns:select="using:Taix.Client.Controls.Select"
             xmlns:Tabbar="using:Taix.Client.Controls.Tabbar"
             xmlns:SettingPanel="using:Taix.Client.Controls.SettingPanel"
             xmlns:input="using:Taix.Client.Controls.Input"
             xmlns:base="using:Taix.Client.Controls.Base"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:Taix.Client.Behaviors"
             x:Class="Taix.Client.Views.SettingPage">
    <i:Interaction.Behaviors>
        <behaviors:ScrollTabSyncBehavior TabbarName="Tabbar"
                                         SectionPrefix="Section"
                                         ScrollViewerName="ContentScrollViewer"
                                         StickyHeaderName="StickyHeader"
                                         StickyTitleTextName="StickyTitleText"
                                         StickyHeaderHeight="55" />
    </i:Interaction.Behaviors>

    <Grid Margin="20" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Settings}" FontSize="18" Margin="0,5,0,20" />
            <Tabbar:Tabbar x:Name="Tabbar"
                HorizontalAlignment="Left" Data="{Binding TabbarData}"
                ItemSpacing="20"
                SelectedIndex="{Binding TabbarSelectedIndex,Mode=TwoWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionContainer" Margin="0,15,0,0">
                <StackPanel x:Name="Section0">
                    <SettingPanel:SettingPanel Data="{Binding GeneralSettings,Mode=TwoWay}" />
                </StackPanel>

                <StackPanel x:Name="Section1" Margin="0,44,0,0">
                    <SettingPanel:SettingPanel Data="{Binding BehaviorSettings,Mode=TwoWay}" />
                </StackPanel>

                <StackPanel x:Name="Section2" Margin="0,44,0,0">
                    <Border Background="{DynamicResource SettingPanelBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Margin="0,0,0,0" BorderBrush="{DynamicResource SettingPanelBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel.Styles>
                                <Style Selector="Border.data-row">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="15,14" />
                                </Style>
                                <Style Selector="Grid.data-row-grid">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                                <Style Selector="Border.data-divider">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Setter Property="Background" Value="{DynamicResource SettingPanelSpliteLineBrush}" />
                                </Style>
                                <Style Selector="TextBlock.data-title">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
                                </Style>
                                <Style Selector="TextBlock.data-desc">
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </Style>
                            </StackPanel.Styles>

                            <!-- 数据保留天数 -->
                            <Border Classes="data-row" CornerRadius="16,16,0,0">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource DataRetentionDays}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource DataRetentionDaysDesc}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" HorizontalAlignment="Right">
                                        <select:TabSwitch Options="{Binding RetentionOptions}"
                                                          SelectedItem="{Binding SelectedRetentionOption, Mode=TwoWay}"
                                                          IsShowIcon="False" HorizontalAlignment="Right" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding IsCustomRetention}" HorizontalAlignment="Right">
                                            <NumericUpDown Value="{Binding DataRetentionDays, Mode=TwoWay}" Minimum="1" Maximum="9999" Width="110" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Days}" VerticalAlignment="Center" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 删除数据 -->
                            <Border Classes="data-row">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource DeleteData}" Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource DeletedAndUnrecoverable}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource From}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding DelDataStartMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                            <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding DelDataEndMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                        </StackPanel>
                                        <Btn:Button Icon="Delete" Content="{DynamicResource Execute}"
                                                    Width="80" Background="{DynamicResource DangerBrush}"
                                                    Foreground="{DynamicResource OnAccentBrush}" Command="{Binding DelDataCommand}"
                                                    ToolTip.Tip="{DynamicResource DeletedAndUnrecoverable}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="data-divider" />

                            <!-- 导出数据 -->
                            <Border Classes="data-row" CornerRadius="0,0,16,16">
                                <Border.Styles>
                                    <Style Selector="Border.data-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="data-row-grid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="data-title" Text="{DynamicResource ExportData}" />
                                        <TextBlock Classes="data-desc" Text="{DynamicResource ExportTo}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource From}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding ExportDataStartMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                            <TextBlock Text="{DynamicResource To}" VerticalAlignment="Center" />
                                            <select:DateSelect Date="{Binding ExportDataEndMonthDate,Mode=TwoWay}" Margin="10,0"
                                                               SelectType="Month" />
                                        </StackPanel>
                                        <Btn:Button Icon="Share" Content="{DynamicResource Export}"
                                                    Width="80" Command="{Binding ExportDataCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Section3" Margin="0,44,0,0">
                    <Border Background="{DynamicResource SettingPanelBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Margin="0,0,0,0"
                            BorderBrush="{DynamicResource SettingPanelBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel.Styles>
                                <Style Selector="Border.shortcut-row">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="15,14" />
                                </Style>
                                <Style Selector="Grid.shortcut-row-grid">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                                <Style Selector="Border.shortcut-divider">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Setter Property="Background" Value="{DynamicResource SettingPanelSpliteLineBrush}" />
                                </Style>
                                <Style Selector="TextBlock.shortcut-title">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{DynamicResource StandardTextBrush}" />
                                </Style>
                                <Style Selector="TextBlock.shortcut-desc">
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </Style>
                            </StackPanel.Styles>

                            <!-- 行 1：刷新 -->
                            <Border Classes="shortcut-row" CornerRadius="16,16,0,0">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock Classes="shortcut-title" Text="{DynamicResource RefreshShortcut}" />
                                    <TextBlock Classes="shortcut-desc" Text="{DynamicResource RefreshShortcutDesc}" />
                                </StackPanel>
                                <input:KeyGestureCapture Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Placeholder="{DynamicResource PressKeysHint}"
                                                         DefaultValue="F5"
                                                         Value="{Binding RefreshShortcut, Mode=TwoWay}" />
                            </Grid>
                            </Border>

                            <Border Classes="shortcut-divider" />

                            <!-- 行 2：搜索 -->
                            <Border Classes="shortcut-row">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock Classes="shortcut-title" Text="{DynamicResource SearchShortcut}" />
                                    <TextBlock Classes="shortcut-desc" Text="{DynamicResource SearchShortcutDesc}" />
                                </StackPanel>
                                <input:KeyGestureCapture Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Placeholder="{DynamicResource PressKeysHint}"
                                                         DefaultValue="Ctrl+K"
                                                         Value="{Binding SearchShortcut, Mode=TwoWay}" />
                            </Grid>
                            </Border>

                            <Border Classes="shortcut-divider" />

                            <!-- 行 3：返回上一页 -->
                            <Border Classes="shortcut-row" CornerRadius="0,0,16,16">
                                <Border.Styles>
                                    <Style Selector="Border.shortcut-row:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SettingPanelHoverBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Classes="shortcut-row-grid" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock Classes="shortcut-title" Text="{DynamicResource NavigateBackShortcut}" />
                                    <TextBlock Classes="shortcut-desc" Text="{DynamicResource NavigateBackShortcutDesc}" />
                                </StackPanel>
                                <input:KeyGestureCapture Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Placeholder="{DynamicResource PressKeysHint}"
                                                         DefaultValue="Alt+Left"
                                                         Value="{Binding NavigateBackShortcut, Mode=TwoWay}" />
                            </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

<StackPanel x:Name="Section4" Margin="0,44,0,0">
                    <Border Background="{DynamicResource SettingPanelBgBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            BorderBrush="{DynamicResource SettingPanelBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- 应用信息 -->
                            <Border Padding="15,14" CornerRadius="16,16,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Image Width="32" Source="/Resources/Icons/tai.ico"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Taix" FontSize="14"
                                                   Foreground="{DynamicResource StandardTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{DynamicResource Version}" FontSize="12"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <TextBlock Text="{Binding Version}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Btn:Button Grid.Column="2"
                                                IsVisible="{Binding CheckUpdateBtnVisibility}"
                                                Command="{Binding CheckUpdate}"
                                                VerticalAlignment="Center" Width="110"
                                                Icon="SetlockScreen" Content="{DynamicResource CheckUpdate}" />
                                </Grid>
                            </Border>

                            <Border Height="1" Opacity="0.5"
                                    Background="{DynamicResource SettingPanelSpliteLineBrush}" />

                            <!-- 插件 -->
                            <Border Padding="15,14">
                                <HyperlinkButton Command="{Binding OpenURL}"
                                                 CommandParameter="https://github.com/Planshit/Tai/discussions/279"
                                                 Content="{DynamicResource PlugIn}" />
                            </Border>

                            <Border Height="1" Opacity="0.5"
                                    Background="{DynamicResource SettingPanelSpliteLineBrush}" />

                            <!-- 开源 -->
                            <Border Padding="15,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource OpenSource}" FontSize="14"
                                               Foreground="{DynamicResource StandardTextBrush}" />
                                    <HyperlinkButton Command="{Binding OpenURL}"
                                                     CommandParameter="https://github.com/NLick47/Taix"
                                                     FontSize="12">
                                        https://github.com/NLick47/Taix
                                    </HyperlinkButton>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Opacity="0.5"
                                    Background="{DynamicResource SettingPanelSpliteLineBrush}" />

                            <!-- 讨论 -->
                            <Border Padding="15,14" CornerRadius="0,0,16,16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Discuss}" FontSize="14"
                                               Foreground="{DynamicResource StandardTextBrush}" />
                                    <HyperlinkButton Command="{Binding OpenURL}"
                                                     CommandParameter="https://github.com/NLick47/Taix/issues"
                                                     FontSize="12">
                                        https://github.com/NLick47/Taix/issues
                                    </HyperlinkButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="StickyHeader"
                Grid.Row="1"
                VerticalAlignment="Top"
                Height="55"
                Opacity="0"
                IsHitTestVisible="False"
                Background="{DynamicResource SettingPanelBgBrush}"
                Classes="sticky-header">
            <Border.Styles>
                <Style Selector="Border.sticky-header">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                        </Transitions>
                    </Setter>
                </Style>
            </Border.Styles>
            <Border.RenderTransform>
                <TranslateTransform Y="-4" />
            </Border.RenderTransform>
            <!-- 下移 15px 与内容对齐，条体顺便遮住下方滚过的内容 -->
            <Border Margin="0,29,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3.5" Height="16" CornerRadius="2"
                            Background="{DynamicResource ThemeBrush}" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="StickyTitleText"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>



