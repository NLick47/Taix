<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Taix.Client.Controls.Button"
                    xmlns:base="using:Taix.Client.Controls.Base">

    <ControlTheme x:Key="{x:Type controls:IconButton}"
                  TargetType="controls:IconButton">
        <Setter Property="Width" Value="35" />
        <Setter Property="Height" Value="35" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Styles>
            <Style Selector="controls|IconButton:pointerover /template/ Border">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            </Style>
            <Style Selector="controls|IconButton /template/ Path#PathIcon">
                <Setter Property="Stroke" Value="{DynamicResource StandardTextBrush}" />
            </Style>
        </Styles>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        x:Name="BoxBorder" CornerRadius="{TemplateBinding CornerRadius}" Padding="5"
                        Background="Transparent">
                    <Grid>
                        <base:Icon x:Name="Icon"
                                   IconType="{TemplateBinding Icon}"
                                   Foreground="{DynamicResource StandardTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="{TemplateBinding FontSize}"
                                   IsVisible="{TemplateBinding PathData, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Path x:Name="PathIcon"
                              Data="{TemplateBinding PathData}"
                              StrokeThickness="{TemplateBinding PathStrokeThickness}"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsVisible="{TemplateBinding PathData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
